# Gemini Developer API key from Google AI Studio
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

# Local development only. Set to id_token in production.
CHAT_AUTH_MODE=disabled
CHAT_AUTH_AUDIENCE=

# Used only when CHAT_AUTH_MODE=disabled to keep local tests scoped.
ALLOWED_TEST_HOSTS=example.com,www.example.com

MAX_PAGE_BYTES=1000000
FETCH_TIMEOUT_SECONDS=12
MAX_REDIRECTS=4
MAX_ARTICLE_CHARS=24000
MODEL_TIMEOUT_SECONDS=20
